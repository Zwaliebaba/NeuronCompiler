/* arm64.def — the ARM64 instruction table (Design/06-arm64-backend.md §1).
 *
 * INSN(id, mnemonic, form, fixed_bits, kd, kn, km, sz)
 *
 *   form        encoding/printing form, see A64Form in a64.h
 *   fixed_bits  the instruction word with all operand fields zero
 *   kd, kn, km  register kinds of MirInst.rd/.rn/.rm (rd also covers Rt, and
 *               MirInst.ra (Ra / Rt2) uses kd's kind); A64KindNone means unused
 *   sz          log2 of the memory access size (loads/stores), else 0;
 *               stored in A64InsnInfo.accessSizeLog2
 *
 * Every entry is covered by the llvm-mc differential test
 * (tests/unit/test_encode.c). Keep entries grouped by encoding class. */

/* ---- add/sub (immediate) ------------------------------------------------ */
INSN(ADDXri,   "add",     A64FormAddsubImm,    0x91000000, A64KindXsp,  A64KindXsp,  A64KindNone, 0)
INSN(ADDWri,   "add",     A64FormAddsubImm,    0x11000000, A64KindWsp,  A64KindWsp,  A64KindNone, 0)
INSN(SUBXri,   "sub",     A64FormAddsubImm,    0xD1000000, A64KindXsp,  A64KindXsp,  A64KindNone, 0)
INSN(SUBWri,   "sub",     A64FormAddsubImm,    0x51000000, A64KindWsp,  A64KindWsp,  A64KindNone, 0)
INSN(ADDSXri,  "adds",    A64FormAddsubImm,    0xB1000000, A64KindX,    A64KindXsp,  A64KindNone, 0)
INSN(ADDSWri,  "adds",    A64FormAddsubImm,    0x31000000, A64KindW,    A64KindWsp,  A64KindNone, 0)
INSN(SUBSXri,  "subs",    A64FormAddsubImm,    0xF1000000, A64KindX,    A64KindXsp,  A64KindNone, 0)
INSN(SUBSWri,  "subs",    A64FormAddsubImm,    0x71000000, A64KindW,    A64KindWsp,  A64KindNone, 0)
INSN(CMPXri,   "cmp",     A64FormCmpImm,       0xF100001F, A64KindNone, A64KindXsp,  A64KindNone, 0)
INSN(CMPWri,   "cmp",     A64FormCmpImm,       0x7100001F, A64KindNone, A64KindWsp,  A64KindNone, 0)
INSN(CMNXri,   "cmn",     A64FormCmpImm,       0xB100001F, A64KindNone, A64KindXsp,  A64KindNone, 0)
INSN(CMNWri,   "cmn",     A64FormCmpImm,       0x3100001F, A64KindNone, A64KindWsp,  A64KindNone, 0)
INSN(MOVXsp,   "mov",     A64FormMovSp,        0x91000000, A64KindXsp,  A64KindXsp,  A64KindNone, 0) /* add rd, rn, #0 */

/* ---- logical (immediate) ------------------------------------------------ */
INSN(ANDXri,   "and",     A64FormLogicImm,     0x92000000, A64KindXsp,  A64KindX,    A64KindNone, 0)
INSN(ORRXri,   "orr",     A64FormLogicImm,     0xB2000000, A64KindXsp,  A64KindX,    A64KindNone, 0)
INSN(EORXri,   "eor",     A64FormLogicImm,     0xD2000000, A64KindXsp,  A64KindX,    A64KindNone, 0)
INSN(ANDSXri,  "ands",    A64FormLogicImm,     0xF2000000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(ANDWri,   "and",     A64FormLogicImm,     0x12000000, A64KindWsp,  A64KindW,    A64KindNone, 0)
INSN(ORRWri,   "orr",     A64FormLogicImm,     0x32000000, A64KindWsp,  A64KindW,    A64KindNone, 0)
INSN(EORWri,   "eor",     A64FormLogicImm,     0x52000000, A64KindWsp,  A64KindW,    A64KindNone, 0)
INSN(ANDSWri,  "ands",    A64FormLogicImm,     0x72000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(TSTXri,   "tst",     A64FormTstImm,       0xF200001F, A64KindNone, A64KindX,    A64KindNone, 0)
INSN(TSTWri,   "tst",     A64FormTstImm,       0x7200001F, A64KindNone, A64KindW,    A64KindNone, 0)

/* ---- move wide ---------------------------------------------------------- */
INSN(MOVZX,    "movz",    A64FormMovw,         0xD2800000, A64KindX,    A64KindNone, A64KindNone, 0)
INSN(MOVZW,    "movz",    A64FormMovw,         0x52800000, A64KindW,    A64KindNone, A64KindNone, 0)
INSN(MOVNX,    "movn",    A64FormMovw,         0x92800000, A64KindX,    A64KindNone, A64KindNone, 0)
INSN(MOVNW,    "movn",    A64FormMovw,         0x12800000, A64KindW,    A64KindNone, A64KindNone, 0)
INSN(MOVKX,    "movk",    A64FormMovw,         0xF2800000, A64KindX,    A64KindNone, A64KindNone, 0)
INSN(MOVKW,    "movk",    A64FormMovw,         0x72800000, A64KindW,    A64KindNone, A64KindNone, 0)

/* ---- PC-relative addressing --------------------------------------------- */
INSN(ADR,      "adr",     A64FormAdr,          0x10000000, A64KindX,    A64KindNone, A64KindNone, 0)
INSN(ADRP,     "adrp",    A64FormAdr,          0x90000000, A64KindX,    A64KindNone, A64KindNone, 0)

/* ---- bitfield ----------------------------------------------------------- */
INSN(SBFMX,    "sbfm",    A64FormBitfield,     0x93400000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(UBFMX,    "ubfm",    A64FormBitfield,     0xD3400000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(BFMX,     "bfm",     A64FormBitfield,     0xB3400000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(SBFMW,    "sbfm",    A64FormBitfield,     0x13000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(UBFMW,    "ubfm",    A64FormBitfield,     0x53000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(BFMW,     "bfm",     A64FormBitfield,     0x33000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(LSLXi,    "lsl",     A64FormLslImm,       0xD3400000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(LSLWi,    "lsl",     A64FormLslImm,       0x53000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(LSRXi,    "lsr",     A64FormLsrImm,       0xD3400000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(LSRWi,    "lsr",     A64FormLsrImm,       0x53000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(ASRXi,    "asr",     A64FormLsrImm,       0x93400000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(ASRWi,    "asr",     A64FormLsrImm,       0x13000000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(SXTBX,    "sxtb",    A64FormExtend,       0x93401C00, A64KindX,    A64KindW,    A64KindNone, 0)
INSN(SXTHX,    "sxth",    A64FormExtend,       0x93403C00, A64KindX,    A64KindW,    A64KindNone, 0)
INSN(SXTWX,    "sxtw",    A64FormExtend,       0x93407C00, A64KindX,    A64KindW,    A64KindNone, 0)
INSN(UXTBW,    "uxtb",    A64FormExtend,       0x53001C00, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(UXTHW,    "uxth",    A64FormExtend,       0x53003C00, A64KindW,    A64KindW,    A64KindNone, 0)

/* ---- logical (shifted register) ----------------------------------------- */
INSN(ANDXrs,   "and",     A64FormLogicReg,     0x8A000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(BICXrs,   "bic",     A64FormLogicReg,     0x8A200000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ORRXrs,   "orr",     A64FormLogicReg,     0xAA000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ORNXrs,   "orn",     A64FormLogicReg,     0xAA200000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(EORXrs,   "eor",     A64FormLogicReg,     0xCA000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(EONXrs,   "eon",     A64FormLogicReg,     0xCA200000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ANDSXrs,  "ands",    A64FormLogicReg,     0xEA000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ANDWrs,   "and",     A64FormLogicReg,     0x0A000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(BICWrs,   "bic",     A64FormLogicReg,     0x0A200000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(ORRWrs,   "orr",     A64FormLogicReg,     0x2A000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(EORWrs,   "eor",     A64FormLogicReg,     0x4A000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(ANDSWrs,  "ands",    A64FormLogicReg,     0x6A000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(MOVXr,    "mov",     A64FormMovReg,       0xAA0003E0, A64KindX,    A64KindNone, A64KindX,    0) /* orr rd, xzr, rm */
INSN(MOVWr,    "mov",     A64FormMovReg,       0x2A0003E0, A64KindW,    A64KindNone, A64KindW,    0)
INSN(MVNXr,    "mvn",     A64FormMovReg,       0xAA2003E0, A64KindX,    A64KindNone, A64KindX,    0)
INSN(MVNWr,    "mvn",     A64FormMovReg,       0x2A2003E0, A64KindW,    A64KindNone, A64KindW,    0)
INSN(TSTXrs,   "tst",     A64FormCmpReg,       0xEA00001F, A64KindNone, A64KindX,    A64KindX,    0)
INSN(TSTWrs,   "tst",     A64FormCmpReg,       0x6A00001F, A64KindNone, A64KindW,    A64KindW,    0)

/* ---- add/sub (shifted register) ----------------------------------------- */
INSN(ADDXrs,   "add",     A64FormAddsubReg,    0x8B000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(SUBXrs,   "sub",     A64FormAddsubReg,    0xCB000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ADDSXrs,  "adds",    A64FormAddsubReg,    0xAB000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(SUBSXrs,  "subs",    A64FormAddsubReg,    0xEB000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ADDWrs,   "add",     A64FormAddsubReg,    0x0B000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(SUBWrs,   "sub",     A64FormAddsubReg,    0x4B000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(ADDSWrs,  "adds",    A64FormAddsubReg,    0x2B000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(SUBSWrs,  "subs",    A64FormAddsubReg,    0x6B000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(CMPXrs,   "cmp",     A64FormCmpReg,       0xEB00001F, A64KindNone, A64KindX,    A64KindX,    0)
INSN(CMPWrs,   "cmp",     A64FormCmpReg,       0x6B00001F, A64KindNone, A64KindW,    A64KindW,    0)
INSN(CMNXrs,   "cmn",     A64FormCmpReg,       0xAB00001F, A64KindNone, A64KindX,    A64KindX,    0)
INSN(NEGXr,    "neg",     A64FormNeg,          0xCB0003E0, A64KindX,    A64KindNone, A64KindX,    0)
INSN(NEGWr,    "neg",     A64FormNeg,          0x4B0003E0, A64KindW,    A64KindNone, A64KindW,    0)

/* ---- add/sub (extended register); rm is W for uxtw/sxtw/... options ----- */
INSN(ADDXrx,   "add",     A64FormAddsubExt,    0x8B200000, A64KindXsp,  A64KindXsp,  A64KindX,    0)
INSN(SUBXrx,   "sub",     A64FormAddsubExt,    0xCB200000, A64KindXsp,  A64KindXsp,  A64KindX,    0)

/* ---- data processing, 3 source ------------------------------------------ */
INSN(MADDX,    "madd",    A64FormDp3,          0x9B000000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(MSUBX,    "msub",    A64FormDp3,          0x9B008000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(MADDW,    "madd",    A64FormDp3,          0x1B000000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(MSUBW,    "msub",    A64FormDp3,          0x1B008000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(SMADDL,   "smaddl",  A64FormDp3,          0x9B200000, A64KindX,    A64KindW,    A64KindW,    0)
INSN(UMADDL,   "umaddl",  A64FormDp3,          0x9BA00000, A64KindX,    A64KindW,    A64KindW,    0)
INSN(MULX,     "mul",     A64FormDp3Noa,       0x9B007C00, A64KindX,    A64KindX,    A64KindX,    0)
INSN(MULW,     "mul",     A64FormDp3Noa,       0x1B007C00, A64KindW,    A64KindW,    A64KindW,    0)
INSN(SMULL,    "smull",   A64FormDp3Noa,       0x9B207C00, A64KindX,    A64KindW,    A64KindW,    0)
INSN(UMULL,    "umull",   A64FormDp3Noa,       0x9BA07C00, A64KindX,    A64KindW,    A64KindW,    0)
INSN(SMULH,    "smulh",   A64FormDp3Noa,       0x9B407C00, A64KindX,    A64KindX,    A64KindX,    0)
INSN(UMULH,    "umulh",   A64FormDp3Noa,       0x9BC07C00, A64KindX,    A64KindX,    A64KindX,    0)

/* ---- data processing, 2 source ------------------------------------------ */
INSN(UDIVX,    "udiv",    A64FormDp2,          0x9AC00800, A64KindX,    A64KindX,    A64KindX,    0)
INSN(SDIVX,    "sdiv",    A64FormDp2,          0x9AC00C00, A64KindX,    A64KindX,    A64KindX,    0)
INSN(UDIVW,    "udiv",    A64FormDp2,          0x1AC00800, A64KindW,    A64KindW,    A64KindW,    0)
INSN(SDIVW,    "sdiv",    A64FormDp2,          0x1AC00C00, A64KindW,    A64KindW,    A64KindW,    0)
INSN(LSLVX,    "lsl",     A64FormDp2,          0x9AC02000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(LSRVX,    "lsr",     A64FormDp2,          0x9AC02400, A64KindX,    A64KindX,    A64KindX,    0)
INSN(ASRVX,    "asr",     A64FormDp2,          0x9AC02800, A64KindX,    A64KindX,    A64KindX,    0)
INSN(RORVX,    "ror",     A64FormDp2,          0x9AC02C00, A64KindX,    A64KindX,    A64KindX,    0)
INSN(LSLVW,    "lsl",     A64FormDp2,          0x1AC02000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(LSRVW,    "lsr",     A64FormDp2,          0x1AC02400, A64KindW,    A64KindW,    A64KindW,    0)
INSN(ASRVW,    "asr",     A64FormDp2,          0x1AC02800, A64KindW,    A64KindW,    A64KindW,    0)

/* ---- conditional select ------------------------------------------------- */
INSN(CSELX,    "csel",    A64FormCsel,         0x9A800000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(CSINCX,   "csinc",   A64FormCsel,         0x9A800400, A64KindX,    A64KindX,    A64KindX,    0)
INSN(CSINVX,   "csinv",   A64FormCsel,         0xDA800000, A64KindX,    A64KindX,    A64KindX,    0)
INSN(CSNEGX,   "csneg",   A64FormCsel,         0xDA800400, A64KindX,    A64KindX,    A64KindX,    0)
INSN(CSELW,    "csel",    A64FormCsel,         0x1A800000, A64KindW,    A64KindW,    A64KindW,    0)
INSN(CSINCW,   "csinc",   A64FormCsel,         0x1A800400, A64KindW,    A64KindW,    A64KindW,    0)
INSN(CSETX,    "cset",    A64FormCset,         0x9A9F07E0, A64KindX,    A64KindNone, A64KindNone, 0) /* csinc rd, xzr, xzr, !cc */
INSN(CSETW,    "cset",    A64FormCset,         0x1A9F07E0, A64KindW,    A64KindNone, A64KindNone, 0)
INSN(CSETMX,   "csetm",   A64FormCset,         0xDA9F03E0, A64KindX,    A64KindNone, A64KindNone, 0) /* csinv rd, xzr, xzr, !cc */

/* ---- data processing, 1 source ------------------------------------------ */
INSN(CLZX,     "clz",     A64FormDp1,          0xDAC01000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(CLZW,     "clz",     A64FormDp1,          0x5AC01000, A64KindW,    A64KindW,    A64KindNone, 0)
INSN(RBITX,    "rbit",    A64FormDp1,          0xDAC00000, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(REVX,     "rev",     A64FormDp1,          0xDAC00C00, A64KindX,    A64KindX,    A64KindNone, 0)
INSN(REVW,     "rev",     A64FormDp1,          0x5AC00800, A64KindW,    A64KindW,    A64KindNone, 0)

/* ---- load/store, unsigned scaled offset --------------------------------- */
INSN(LDRXui,   "ldr",     A64FormLdstUimm,     0xF9400000, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(STRXui,   "str",     A64FormLdstUimm,     0xF9000000, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(LDRWui,   "ldr",     A64FormLdstUimm,     0xB9400000, A64KindW,    A64KindXsp,  A64KindNone, 2)
INSN(STRWui,   "str",     A64FormLdstUimm,     0xB9000000, A64KindW,    A64KindXsp,  A64KindNone, 2)
INSN(LDRHHui,  "ldrh",    A64FormLdstUimm,     0x79400000, A64KindW,    A64KindXsp,  A64KindNone, 1)
INSN(STRHHui,  "strh",    A64FormLdstUimm,     0x79000000, A64KindW,    A64KindXsp,  A64KindNone, 1)
INSN(LDRBBui,  "ldrb",    A64FormLdstUimm,     0x39400000, A64KindW,    A64KindXsp,  A64KindNone, 0)
INSN(STRBBui,  "strb",    A64FormLdstUimm,     0x39000000, A64KindW,    A64KindXsp,  A64KindNone, 0)
INSN(LDRSWui,  "ldrsw",   A64FormLdstUimm,     0xB9800000, A64KindX,    A64KindXsp,  A64KindNone, 2)
INSN(LDRSHXui, "ldrsh",   A64FormLdstUimm,     0x79800000, A64KindX,    A64KindXsp,  A64KindNone, 1)
INSN(LDRSBXui, "ldrsb",   A64FormLdstUimm,     0x39800000, A64KindX,    A64KindXsp,  A64KindNone, 0)
INSN(LDRSHWui, "ldrsh",   A64FormLdstUimm,     0x79C00000, A64KindW,    A64KindXsp,  A64KindNone, 1)
INSN(LDRSBWui, "ldrsb",   A64FormLdstUimm,     0x39C00000, A64KindW,    A64KindXsp,  A64KindNone, 0)
INSN(LDRDui,   "ldr",     A64FormLdstUimm,     0xFD400000, A64KindD,    A64KindXsp,  A64KindNone, 3)
INSN(STRDui,   "str",     A64FormLdstUimm,     0xFD000000, A64KindD,    A64KindXsp,  A64KindNone, 3)
INSN(LDRSui,   "ldr",     A64FormLdstUimm,     0xBD400000, A64KindS,    A64KindXsp,  A64KindNone, 2)
INSN(STRSui,   "str",     A64FormLdstUimm,     0xBD000000, A64KindS,    A64KindXsp,  A64KindNone, 2)
INSN(LDRQui,   "ldr",     A64FormLdstUimm,     0x3DC00000, A64KindQ,    A64KindXsp,  A64KindNone, 4)
INSN(STRQui,   "str",     A64FormLdstUimm,     0x3D800000, A64KindQ,    A64KindXsp,  A64KindNone, 4)

/* ---- load/store, 9-bit signed offset: pre-index, post-index, unscaled ---- */
INSN(STRXpre,  "str",     A64FormLdstPre,      0xF8000C00, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(LDRXpre,  "ldr",     A64FormLdstPre,      0xF8400C00, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(STRXpost, "str",     A64FormLdstPost,     0xF8000400, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(LDRXpost, "ldr",     A64FormLdstPost,     0xF8400400, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(STRDpre,  "str",     A64FormLdstPre,      0xFC000C00, A64KindD,    A64KindXsp,  A64KindNone, 3)
INSN(LDRDpre,  "ldr",     A64FormLdstPre,      0xFC400C00, A64KindD,    A64KindXsp,  A64KindNone, 3)
INSN(STRDpost, "str",     A64FormLdstPost,     0xFC000400, A64KindD,    A64KindXsp,  A64KindNone, 3)
INSN(LDRDpost, "ldr",     A64FormLdstPost,     0xFC400400, A64KindD,    A64KindXsp,  A64KindNone, 3)
INSN(LDURX,    "ldur",    A64FormLdstUnscaled, 0xF8400000, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(STURX,    "stur",    A64FormLdstUnscaled, 0xF8000000, A64KindX,    A64KindXsp,  A64KindNone, 3)
INSN(LDURW,    "ldur",    A64FormLdstUnscaled, 0xB8400000, A64KindW,    A64KindXsp,  A64KindNone, 2)
INSN(STURW,    "stur",    A64FormLdstUnscaled, 0xB8000000, A64KindW,    A64KindXsp,  A64KindNone, 2)

/* ---- load/store, register offset (rm extended by MirInst.shift option) ---- */
INSN(LDRXro,   "ldr",     A64FormLdstReg,      0xF8600800, A64KindX,    A64KindXsp,  A64KindX,    3)
INSN(STRXro,   "str",     A64FormLdstReg,      0xF8200800, A64KindX,    A64KindXsp,  A64KindX,    3)
INSN(LDRWro,   "ldr",     A64FormLdstReg,      0xB8600800, A64KindW,    A64KindXsp,  A64KindX,    2)
INSN(STRWro,   "str",     A64FormLdstReg,      0xB8200800, A64KindW,    A64KindXsp,  A64KindX,    2)
INSN(LDRSWro,  "ldrsw",   A64FormLdstReg,      0xB8A00800, A64KindX,    A64KindXsp,  A64KindX,    2)
INSN(LDRBBro,  "ldrb",    A64FormLdstReg,      0x38600800, A64KindW,    A64KindXsp,  A64KindX,    0)
